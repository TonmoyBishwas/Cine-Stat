# Copy this file to ".env" and put your own key in it.
#
#     cp .env.example .env
#
# .env is listed in .gitignore, so the key never reaches GitHub.
# Get a key from https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-put-your-key-here

# Optional. Any model slug from https://openrouter.ai/models works here.
# The default is a small, cheap, fast model, which is plenty for writing
# three sentences. Uncomment to change it.
# OPENROUTER_MODEL=anthropic/claude-3.5-haiku
