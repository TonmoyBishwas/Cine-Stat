# Copy this file to ".env" and put your own key in it. COPY it, do not rename
# it - this file is the template the next person needs, and it is the one that
# is committed. ".env" is the one with your key in, and it is in .gitignore so
# it never reaches GitHub.
#
#     Windows:   copy .env.example .env
#     macOS:     cp .env.example .env
#
# Get a key from https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-put-your-key-here

# Optional. Any model slug from https://openrouter.ai/models works here.
# The default is a small, cheap, fast model, which is plenty for writing
# three sentences. Uncomment to change it.
#
# Slugs get RETIRED. A retired one answers HTTP 404 "No endpoints found",
# which looks exactly like a broken key from the outside, so check the model
# list before blaming your key. Avoid "reasoning" models here: they think to
# themselves before answering, and that thinking is charged against the same
# token budget as the answer.
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite
